{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Activity": {
      "enum": [
        "hiking",
        "walking",
        "trail_running",
        "running",
        "road",
        "gravel",
        "mtb",
        "other"
      ],
      "title": "Activity",
      "type": "string"
    },
    "ClosureAssessmentSummary": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "title": "Date",
          "type": "string"
        },
        "status": {
          "enum": [
            "known_conflict",
            "possible_conflict",
            "no_known_conflict",
            "coverage_unknown",
            "check_failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "source_status": {
          "enum": [
            "ok",
            "partial",
            "failed",
            "fixture"
          ],
          "title": "Source Status",
          "type": "string"
        },
        "stale": {
          "title": "Stale",
          "type": "boolean"
        },
        "unknown_coverage": {
          "title": "Unknown Coverage",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "high",
            "moderate",
            "low",
            "unknown"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "date",
        "status",
        "source_status",
        "stale",
        "unknown_coverage",
        "warnings",
        "confidence"
      ],
      "title": "ClosureAssessmentSummary",
      "type": "object"
    },
    "DiscoveryProviderStatus": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "unsupported",
            "degraded",
            "disabled"
          ],
          "title": "Status",
          "type": "string"
        },
        "result_count": {
          "default": 0,
          "title": "Result Count",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "cached": {
          "default": false,
          "title": "Cached",
          "type": "boolean"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "status"
      ],
      "title": "DiscoveryProviderStatus",
      "type": "object"
    },
    "Geometry": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "LineString",
            "MultiLineString"
          ],
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "maximum": 180,
                    "minimum": -180,
                    "type": "number"
                  },
                  {
                    "maximum": 90,
                    "minimum": -90,
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "items": {
                "items": {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "maximum": 180,
                      "minimum": -180,
                      "type": "number"
                    },
                    {
                      "maximum": 90,
                      "minimum": -90,
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                "type": "array"
              },
              "type": "array"
            }
          ],
          "title": "Coordinates"
        },
        "crs": {
          "const": "EPSG:4326",
          "default": "EPSG:4326",
          "title": "Crs",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "Geometry",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "value",
        "source_url",
        "observed_at"
      ],
      "title": "Metric",
      "type": "object"
    },
    "RankedRoute": {
      "additionalProperties": false,
      "properties": {
        "route": {
          "$ref": "#/$defs/Route"
        },
        "ranking": {
          "$ref": "#/$defs/RankingExplanation"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/SourceProvenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "closure_assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClosureAssessmentSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "route",
        "ranking"
      ],
      "title": "RankedRoute",
      "type": "object"
    },
    "RankingExplanation": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "title": "Score",
          "type": "number"
        },
        "factors": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Factors",
          "type": "object"
        },
        "explanations": {
          "items": {
            "type": "string"
          },
          "title": "Explanations",
          "type": "array"
        }
      },
      "required": [
        "score",
        "factors",
        "explanations"
      ],
      "title": "RankingExplanation",
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "provider_route_id": {
          "title": "Provider Route Id",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType",
          "default": "unknown"
        },
        "attribution": {
          "title": "Attribution",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "activity": {
          "$ref": "#/$defs/Activity",
          "default": "other"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "start_lat": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Lat"
        },
        "start_lon": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Lon"
        },
        "end_lat": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Lat"
        },
        "end_lon": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Lon"
        },
        "distance_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance M"
        },
        "elevation_gain_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation Gain M"
        },
        "is_loop": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Loop"
        },
        "popularity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rating": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reviews_count": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "geometry_quality": {
          "default": "unknown",
          "enum": [
            "complete",
            "disconnected",
            "incomplete",
            "unknown"
          ],
          "title": "Geometry Quality",
          "type": "string"
        },
        "gpx_access": {
          "default": "unverified",
          "enum": [
            "available",
            "restricted",
            "unverified",
            "unavailable"
          ],
          "title": "Gpx Access",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "raw_metadata": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Raw Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "provider",
        "provider_route_id",
        "attribution",
        "name"
      ],
      "title": "Route",
      "type": "object"
    },
    "SourceProvenance": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "provider_route_id": {
          "title": "Provider Route Id",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Url"
        },
        "attribution": {
          "title": "Attribution",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        }
      },
      "required": [
        "provider",
        "id",
        "provider_route_id",
        "source_url",
        "attribution",
        "source_type"
      ],
      "title": "SourceProvenance",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "community",
        "official_trail",
        "generated",
        "unknown"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "routes": {
      "items": {
        "$ref": "#/$defs/RankedRoute"
      },
      "title": "Routes",
      "type": "array"
    },
    "total": {
      "default": 0,
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    },
    "provider_status": {
      "items": {
        "$ref": "#/$defs/DiscoveryProviderStatus"
      },
      "title": "Provider Status",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "partial": {
      "default": false,
      "title": "Partial",
      "type": "boolean"
    }
  },
  "required": [
    "routes",
    "provider_status"
  ],
  "title": "DiscoveryResult",
  "type": "object"
}
