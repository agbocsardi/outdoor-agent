{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "route_id": {
      "title": "Route Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "severity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Severity"
    },
    "classification": {
      "enum": [
        "known_conflict",
        "possible_conflict",
        "no_known_conflict",
        "coverage_unknown",
        "check_failed"
      ],
      "title": "Classification",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "distance_along_route_m": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Distance Along Route M"
    },
    "min_distance_to_route_m": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Distance To Route M"
    },
    "overlap_length_m": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Overlap Length M"
    },
    "temporal_overlap": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temporal Overlap"
    },
    "mode_overlap": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mode Overlap"
    },
    "geometry_confidence": {
      "default": "unknown",
      "enum": [
        "precise",
        "approximate",
        "unknown"
      ],
      "title": "Geometry Confidence",
      "type": "string"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "route_id",
    "event_id",
    "classification",
    "reason"
  ],
  "title": "ClosureFinding",
  "type": "object"
}
