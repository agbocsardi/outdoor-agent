{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Activity": {
      "enum": [
        "hiking",
        "walking",
        "trail_running",
        "running",
        "road",
        "gravel",
        "mtb",
        "other"
      ],
      "title": "Activity",
      "type": "string"
    },
    "GPXArtifact": {
      "additionalProperties": false,
      "properties": {
        "route_id": {
          "title": "Route Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "byte_count": {
          "title": "Byte Count",
          "type": "integer"
        }
      },
      "required": [
        "route_id",
        "path",
        "sha256",
        "byte_count"
      ],
      "title": "GPXArtifact",
      "type": "object"
    },
    "GPXInspection": {
      "additionalProperties": false,
      "properties": {
        "route": {
          "$ref": "#/$defs/Route"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "byte_count": {
          "title": "Byte Count",
          "type": "integer"
        },
        "bounds": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            }
          ],
          "title": "Bounds",
          "type": "array"
        },
        "track_count": {
          "title": "Track Count",
          "type": "integer"
        },
        "track_segment_count": {
          "title": "Track Segment Count",
          "type": "integer"
        },
        "route_count": {
          "title": "Route Count",
          "type": "integer"
        },
        "point_count": {
          "title": "Point Count",
          "type": "integer"
        },
        "segment_point_counts": {
          "items": {
            "type": "integer"
          },
          "title": "Segment Point Counts",
          "type": "array"
        },
        "waypoints": {
          "items": {
            "$ref": "#/$defs/Waypoint"
          },
          "title": "Waypoints",
          "type": "array"
        },
        "distance_method": {
          "const": "WGS84 geodesic; segment gaps excluded",
          "default": "WGS84 geodesic; segment gaps excluded",
          "title": "Distance Method",
          "type": "string"
        },
        "geometry_precision": {
          "const": "original coordinates; no simplification",
          "default": "original coordinates; no simplification",
          "title": "Geometry Precision",
          "type": "string"
        }
      },
      "required": [
        "route",
        "sha256",
        "byte_count",
        "bounds",
        "track_count",
        "track_segment_count",
        "route_count",
        "point_count",
        "segment_point_counts",
        "waypoints"
      ],
      "title": "GPXInspection",
      "type": "object"
    },
    "Geometry": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "LineString",
            "MultiLineString"
          ],
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "maximum": 180,
                    "minimum": -180,
                    "type": "number"
                  },
                  {
                    "maximum": 90,
                    "minimum": -90,
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "items": {
                "items": {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "maximum": 180,
                      "minimum": -180,
                      "type": "number"
                    },
                    {
                      "maximum": 90,
                      "minimum": -90,
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                "type": "array"
              },
              "type": "array"
            }
          ],
          "title": "Coordinates"
        },
        "crs": {
          "const": "EPSG:4326",
          "default": "EPSG:4326",
          "title": "Crs",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "Geometry",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "value",
        "source_url",
        "observed_at"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "provider_route_id": {
          "title": "Provider Route Id",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType",
          "default": "unknown"
        },
        "attribution": {
          "title": "Attribution",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "activity": {
          "$ref": "#/$defs/Activity",
          "default": "other"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "start_lat": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Lat"
        },
        "start_lon": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Lon"
        },
        "end_lat": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Lat"
        },
        "end_lon": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Lon"
        },
        "distance_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance M"
        },
        "elevation_gain_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation Gain M"
        },
        "is_loop": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Loop"
        },
        "popularity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rating": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reviews_count": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "geometry_quality": {
          "default": "unknown",
          "enum": [
            "complete",
            "disconnected",
            "incomplete",
            "unknown"
          ],
          "title": "Geometry Quality",
          "type": "string"
        },
        "gpx_access": {
          "default": "unverified",
          "enum": [
            "available",
            "restricted",
            "unverified",
            "unavailable"
          ],
          "title": "Gpx Access",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "raw_metadata": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Raw Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "provider",
        "provider_route_id",
        "attribution",
        "name"
      ],
      "title": "Route",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "community",
        "official_trail",
        "generated",
        "unknown"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "Waypoint": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "elevation_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation M"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "Waypoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "inspection": {
      "$ref": "#/$defs/GPXInspection"
    },
    "artifact": {
      "$ref": "#/$defs/GPXArtifact"
    },
    "already_present": {
      "title": "Already Present",
      "type": "boolean"
    }
  },
  "required": [
    "inspection",
    "artifact",
    "already_present"
  ],
  "title": "ImportResult",
  "type": "object"
}
