{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ClosureEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "location_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Reference"
        },
        "geometry_quality": {
          "default": "unresolved",
          "enum": [
            "precise",
            "approximate",
            "incomplete",
            "unresolved"
          ],
          "title": "Geometry Quality",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "starts_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Starts At"
        },
        "ends_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ends At"
        },
        "recurrence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recurrence"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        },
        "affected_modes": {
          "items": {
            "enum": [
              "road",
              "bike",
              "foot",
              "other"
            ],
            "type": "string"
          },
          "title": "Affected Modes",
          "type": "array"
        },
        "restriction_type": {
          "title": "Restriction Type",
          "type": "string"
        },
        "direction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "raw_metadata_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Metadata Reference"
        },
        "timing_quality": {
          "default": "unknown",
          "enum": [
            "precise",
            "approximate",
            "unknown"
          ],
          "title": "Timing Quality",
          "type": "string"
        },
        "location_reference_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Reference Type"
        },
        "restriction_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Restriction Evidence",
          "type": "array"
        },
        "mode_evidence": {
          "default": "unknown",
          "enum": [
            "explicit",
            "scope",
            "unknown"
          ],
          "title": "Mode Evidence",
          "type": "string"
        },
        "grade_separation_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Grade Separation Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "provider",
        "description",
        "restriction_type",
        "status"
      ],
      "title": "ClosureEvent",
      "type": "object"
    },
    "ClosureFinding": {
      "additionalProperties": false,
      "properties": {
        "route_id": {
          "title": "Route Id",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "classification": {
          "enum": [
            "known_conflict",
            "possible_conflict",
            "no_known_conflict",
            "coverage_unknown",
            "check_failed"
          ],
          "title": "Classification",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "distance_along_route_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Along Route M"
        },
        "min_distance_to_route_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Distance To Route M"
        },
        "overlap_length_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overlap Length M"
        },
        "temporal_overlap": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal Overlap"
        },
        "mode_overlap": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode Overlap"
        },
        "geometry_confidence": {
          "default": "unknown",
          "enum": [
            "precise",
            "approximate",
            "unknown"
          ],
          "title": "Geometry Confidence",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "route_id",
        "event_id",
        "classification",
        "reason"
      ],
      "title": "ClosureFinding",
      "type": "object"
    },
    "ClosureSourceError": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "source",
        "code",
        "message"
      ],
      "title": "ClosureSourceError",
      "type": "object"
    },
    "ClosureSourceFreshness": {
      "additionalProperties": false,
      "description": "Per-source refresh and feed publication provenance.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "last_successful_refresh": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Successful Refresh"
        },
        "publication_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication At"
        },
        "etag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Etag"
        },
        "last_modified": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Modified"
        },
        "from_cache": {
          "default": false,
          "title": "From Cache",
          "type": "boolean"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "refresh_age_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh Age Seconds"
        },
        "publication_age_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Age Seconds"
        }
      },
      "required": [
        "source"
      ],
      "title": "ClosureSourceFreshness",
      "type": "object"
    },
    "Geometry": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "LineString",
            "MultiLineString"
          ],
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "maximum": 180,
                    "minimum": -180,
                    "type": "number"
                  },
                  {
                    "maximum": 90,
                    "minimum": -90,
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "items": {
                "items": {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "maximum": 180,
                      "minimum": -180,
                      "type": "number"
                    },
                    {
                      "maximum": 90,
                      "minimum": -90,
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                "type": "array"
              },
              "type": "array"
            }
          ],
          "title": "Coordinates"
        },
        "crs": {
          "const": "EPSG:4326",
          "default": "EPSG:4326",
          "title": "Crs",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "Geometry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Conservative route assessment plus the feed provenance needed to interpret it.",
  "properties": {
    "route_id": {
      "title": "Route Id",
      "type": "string"
    },
    "activity": {
      "title": "Activity",
      "type": "string"
    },
    "requested_date": {
      "title": "Requested Date",
      "type": "string"
    },
    "request_precision": {
      "default": "date",
      "enum": [
        "date",
        "instant"
      ],
      "title": "Request Precision",
      "type": "string"
    },
    "request_timezone": {
      "default": "Europe/Amsterdam",
      "title": "Request Timezone",
      "type": "string"
    },
    "window_start": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Window Start"
    },
    "window_end": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Window End"
    },
    "status": {
      "enum": [
        "known_conflict",
        "possible_conflict",
        "no_known_conflict",
        "coverage_unknown",
        "check_failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "source_status": {
      "enum": [
        "ok",
        "partial",
        "failed",
        "fixture"
      ],
      "title": "Source Status",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ClosureFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/ClosureEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "source_errors": {
      "items": {
        "$ref": "#/$defs/ClosureSourceError"
      },
      "title": "Source Errors",
      "type": "array"
    },
    "source_freshness": {
      "items": {
        "$ref": "#/$defs/ClosureSourceFreshness"
      },
      "title": "Source Freshness",
      "type": "array"
    },
    "source_ages_seconds": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Source Ages Seconds",
      "type": "object"
    },
    "fetched_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fetched At"
    },
    "source_age_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Age Seconds"
    },
    "stale": {
      "default": false,
      "title": "Stale",
      "type": "boolean"
    },
    "fixture_mode": {
      "default": false,
      "title": "Fixture Mode",
      "type": "boolean"
    },
    "unknown_coverage": {
      "default": false,
      "title": "Unknown Coverage",
      "type": "boolean"
    },
    "observed_horizon_end": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Horizon End"
    },
    "horizon_status": {
      "default": "unknown",
      "enum": [
        "within_observed_horizon",
        "beyond_observed_horizon",
        "historical_not_covered",
        "unknown"
      ],
      "title": "Horizon Status",
      "type": "string"
    },
    "coverage": {
      "default": "Netherlands road works only; footpaths, trails, parks and forestry closures are not established as covered.",
      "title": "Coverage",
      "type": "string"
    },
    "distance_crs": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Distance Crs"
    },
    "distance_method": {
      "default": "projected line operations; disconnected route segments are measured separately",
      "title": "Distance Method",
      "type": "string"
    }
  },
  "required": [
    "route_id",
    "activity",
    "requested_date",
    "status",
    "source_status"
  ],
  "title": "ClosureReport",
  "type": "object"
}
