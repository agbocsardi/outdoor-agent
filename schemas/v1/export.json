{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "status": {
      "default": "exported",
      "title": "Status",
      "type": "string"
    },
    "route_id": {
      "title": "Route Id",
      "type": "string"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "sha256": {
      "title": "Sha256",
      "type": "string"
    },
    "byte_count": {
      "title": "Byte Count",
      "type": "integer"
    },
    "original_bytes": {
      "title": "Original Bytes",
      "type": "boolean"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Url"
    },
    "attribution": {
      "title": "Attribution",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "route_id",
    "path",
    "sha256",
    "byte_count",
    "original_bytes",
    "source_url",
    "attribution"
  ],
  "title": "ExportResult",
  "type": "object"
}
