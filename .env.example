# Reference only: outdoor-agent does not load .env automatically.
# Inject values through your shell/process manager or a private config.toml.
# Never commit real credentials. Custom endpoints must be public HTTPS hosts.

OUTDOOR_AGENT_DATA_DIR=
OUTDOOR_AGENT_CACHE_DIR=
OUTDOOR_AGENT_DEFAULT_TIMEZONE=Europe/Amsterdam
OUTDOOR_AGENT_DEFAULT_REGION=NL
OUTDOOR_AGENT_HTTP_TIMEOUT_SECONDS=20
OUTDOOR_AGENT_HTTP_USER_AGENT='outdoor-agent/0.2.0 (+https://github.com/agbocsardi/outdoor-agent)'
OUTDOOR_AGENT_OFFLINE=false

OUTDOOR_AGENT_OVERPASS_URL=https://overpass-api.de/api/interpreter
OUTDOOR_AGENT_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OUTDOOR_AGENT_NDW_CLOSURES_URL=https://opendata.ndw.nu/tijdelijke_verkeersmaatregelen_afsluitingen.xml.gz
OUTDOOR_AGENT_NDW_PLANNED_URL=https://opendata.ndw.nu/planningsfeed_wegwerkzaamheden_en_evenementen.xml.gz
OUTDOOR_AGENT_DISCOVERY_CACHE_TTL_SECONDS=86400
OUTDOOR_AGENT_NDW_CACHE_TTL_SECONDS=600
OUTDOOR_AGENT_NDW_MAX_AGE_SECONDS=3600
OUTDOOR_AGENT_CLOSURE_BUFFER_M=20
OUTDOOR_AGENT_PLACES_CACHE_TTL_SECONDS=0
# Reserved setting; Google Places responses are currently never cached or persisted.

# Optional Ride with GPS reads. Both credentials are sent only in provider headers.
RIDEWITHGPS_API_KEY=
RIDEWITHGPS_AUTH_TOKEN=

# Google Places stays disabled with a zero example budget until explicitly configured.
OUTDOOR_AGENT_GOOGLE_ENABLED=false
OUTDOOR_AGENT_MAX_GOOGLE_REQUESTS_PER_RUN=0
GOOGLE_MAPS_API_KEY=

# Configure disabled_providers as a TOML string array, for example:
# disabled_providers = ["ridewithgps"]
